{
  "description": "TSUZU local-only Codex prompt memory, partial Chronicle, and passive proposal hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/tsuzu_codex_turn.py\"",
            "timeout": 10,
            "statusMessage": "Saving TSUZU memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/tsuzu_codex_turn.py\"",
            "timeout": 10,
            "statusMessage": "Recording TSUZU Chronicle"
          }
        ]
      }
    ]
  }
}
